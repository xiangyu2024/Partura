# common._sum
def _sum(x: torch.Tensor) -> torch.Tensor:
    value = x.nansum(dim=-1)
    return torch.where(
        torch.isfinite(x).any(dim=-1), value, torch.full_like(value, float("nan"))
    )

# common._mean
def _mean(x: torch.Tensor) -> torch.Tensor:
    return x.nanmean(dim=-1)

