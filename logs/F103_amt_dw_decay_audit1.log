--- alphacube.operators.dt_cross.decay_linear_last  (9 lines)
def decay_linear_last(w: torch.Tensor) -> torch.Tensor:
    """Linearly-weighted (most recent = heaviest) mean over valid entries."""
    d = w.shape[-1]
    weights = torch.arange(1, d + 1, dtype=w.dtype, device=w.device)
    valid = ~torch.isnan(w)
    w_filled = torch.where(valid, w, torch.zeros_like(w))
    weighted_sum = (w_filled * weights).sum(dim=-1)
    weight_total = (valid.to(w.dtype) * weights).sum(dim=-1)
    return torch.where(weight_total > EPS, weighted_sum / weight_total, torch.full_like(weighted_sum, float("nan")))
--- alphacube.operators.dt_cross.nanmax_last  (4 lines)
def nanmax_last(w: torch.Tensor) -> torch.Tensor:
    filled = torch.where(torch.isnan(w), torch.full_like(w, float("-inf")), w)
    out = filled.max(dim=-1).values
    return torch.where(torch.isnan(w).all(dim=-1), torch.full_like(out, float("nan")), out)
--- alphacube.operators.dt_day.last_valid_last  (13 lines)
def last_valid_last(w: torch.Tensor) -> torch.Tensor:
    """Last non-NaN value along the last dim; NaN if the slice has none.
    Shared by DT's `day_last`/`in_last`, same contract as `first_valid_last`.
    """
    d = w.shape[-1]
    idx = torch.arange(d, device=w.device).expand_as(w)
    valid = ~torch.isnan(w)
    idx_when_valid = torch.where(valid, idx, torch.full_like(idx, -1))
    last_idx = idx_when_valid.max(dim=-1, keepdim=True).values
    has_valid = last_idx >= 0
    last_idx_safe = torch.where(has_valid, last_idx, torch.zeros_like(last_idx))
    val = torch.gather(w, -1, last_idx_safe)
    return torch.where(has_valid, val, torch.full_like(val, float("nan"))).squeeze(-1)
--- alphacube.operators.common.pow_  (10 lines)
@op("shared", "elementwise", arity=1)
def pow_(x: torch.Tensor, e) -> torch.Tensor:
    """Signed power: `sign(x)*|x|^e` for `e<=1` (keeps sign through
    fractional powers), plain `x**e` otherwise. `e` may be a tensor
    (broadcasts) or a python scalar.
    """
    if isinstance(e, (int, float)):
        e = torch.tensor(e, dtype=x.dtype, device=x.device)
    x_b, e_b = torch.broadcast_tensors(x, e)
    return torch.where(e_b <= 1.0, torch.sign(x_b) * torch.pow(x_b.abs(), e_b), torch.pow(x_b, e_b))
--- alphacube.metrics.ema_rows  (20 lines)
def ema_rows(panel: np.ndarray, halflife: float) -> np.ndarray:
    """Causal per-stock EMA along days: ``s_t = a * x_t + (1 - a) * s_t-1`` with
    ``a = 1 - 0.5 ** (1 / halflife)``. A missing day leaves the state as it was and
    is missing in the output (nothing to trade that day); a stock's first finite
    value starts its state. ``halflife <= 0`` returns the panel unchanged."""
    x = np.asarray(panel, dtype=np.float64)
    if halflife <= 0:
        return x
    a = 1.0 - 0.5 ** (1.0 / float(halflife))
    out = np.full_like(x, np.nan)
    state = np.full(x.shape[1], np.nan)
    for t in range(x.shape[0]):
        row = x[t]
        fin = np.isfinite(row)
        fresh = fin & ~np.isfinite(state)
        state = np.where(fresh, row, state)
        upd = fin & ~fresh
        state[upd] = a * row[upd] + (1.0 - a) * state[upd]
        out[t, fin] = state[fin]
    return out
--- alphacube.metrics.long_short_weights  (26 lines)
def long_short_weights(alpha: np.ndarray, top_frac: float) -> np.ndarray:
    """(D, S) alpha -> (D, S) target weights: equal-weight long the top ``top_frac``,
    short the bottom, gross exposure 1 (so +0.5 long / -0.5 short) and net 0.
    Days with too few names are all-zero rather than NaN, so a gap in the alpha
    means "hold nothing", not "hold the previous book forever".

    Ties at a boundary go by symbol order (a stable sort). numpy's default sort
    is not stable, and which of the tied names it put in the book depended on
    the rest of the row: nudging one mid-ranked name changed the book in 12 of
    200 tied rows, i.e. turnover charged for trades nobody would make. With
    turnover now part of the GP fitness (``rank_ic_turnover`` builds the same
    book in torch) that noise would also have been selected against."""
    alpha = np.asarray(alpha, dtype=np.float64)
    D, S = alpha.shape
    fin = np.isfinite(alpha)
    n = fin.sum(axis=1)
    order = np.argsort(np.where(fin, alpha, np.inf), axis=1, kind="stable")     # non-finite last
    k = np.maximum(1, np.floor(n * top_frac).astype(np.int64))
    pos = np.arange(S)[None, :]
    ok = (n >= 2)[:, None]
    long_ = ok & (pos >= (n - k)[:, None]) & (pos < n[:, None])
    short = ok & (pos < k[:, None])
    w_sorted = np.where(long_, 0.5 / k[:, None], np.where(short, -0.5 / k[:, None], 0.0))
    w = np.zeros((D, S), dtype=np.float64)
    np.put_along_axis(w, order, w_sorted, axis=1)
    return w
--- alphacube.operators.common._sum  (5 lines)
def _sum(x: torch.Tensor) -> torch.Tensor:
    value = x.nansum(dim=-1)
    return torch.where(
        torch.isfinite(x).any(dim=-1), value, torch.full_like(value, float("nan"))
    )
