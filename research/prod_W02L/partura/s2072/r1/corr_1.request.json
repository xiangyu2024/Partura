ini(Volume), 60), cross_mean(day_std(Ret), 60))"}, {"where": "slot b seed 8", "expr": "cross_mean(day_centroid(Amt), 60)"}, {"where": "slot b seed 9", "expr": "sub(cross_mean(day_centroid(Volume), 10), cross_mean(day_centroid(Volume), 120))"}, {"where": "slot b seed 10", "expr": "cross_mean(div(day_gini(Volume), day_gini(Amt)), 60)"}, {"where": "slot b seed 11", "expr": "cross_ema(sub(day_gini(Volume), day_gini(abs_(Ret))), 20)"}, {"where": "slot b seed 12", "expr": "cross_mean(mul(day_centroid(Volume), sign(day_sum(Ret))), 60)"}]
